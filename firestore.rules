rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquiera que entre a la app (login anónimo automático) puede
    // leer y escribir el gasto compartido y la config del evento.
    // No es una app pública en internet: solo quien tenga el link
    // llega a esta pantalla, así que esto alcanza para un grupo de amigos.
    match /config/{docId} {
      allow read, write: if request.auth != null;
    }
    match /expenses/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
